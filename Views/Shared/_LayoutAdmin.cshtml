<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Panel Administrador</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background-color: #f7f7f7;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 230px;
            height: 100vh;
            background-color: #72103A;
            color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-top: 25px;
        }

            .sidebar img {
                width: 100px;
                margin-bottom: 25px;
            }

            .sidebar a {
                color: #fff;
                text-decoration: none;
                display: block;
                width: 100%;
                padding: 12px 20px;
                font-size: 16px;
                text-align: left;
                transition: background 0.3s;
            }

                .sidebar a:hover,
                .sidebar a.active {
                    background-color: #8e2753;
                }

        /* Contador de llaves */
        .llaves-counter {
            margin-top: auto;
            background-color: #fff;
            color: #72103A;
            font-weight: 600;
            font-size: 15px;
            text-align: center;
            border-radius: 10px;
            padding: 8px 10px;
            width: 90%;
            box-shadow: 0 0 8px rgba(0,0,0,0.2);
        }

            .llaves-counter i {
                color: #72103A;
            }

        /* Contenedor principal */
        .content {
            margin-left: 230px;
            padding: 30px;
        }

        .admin-header {
            color: #72103A;
            font-weight: 600;
            margin-bottom: 25px;
        }

        /* Botones */
        .btn-admin {
            background-color: #72103A;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 10px 18px;
        }

            .btn-admin:hover {
                background-color: #8e2753;
            }

        /* Badge visual para alertar */
        .badge-alert {
            background-color: #dc3545;
            color: white;
            border-radius: 50%;
            padding: 4px 8px;
            font-size: 13px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <img src="/images/logo.png" alt="Logo UNIVALLE" />

        <a href="/Admin/Index" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">° Dashboard</a>
        <a href="/Admin/RegistrarUsuario" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "RegistrarUsuario" ? "active" : "")">° Registrar</a>
        <a href="/Admin/VerUsuarios" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "VerUsuarios" ? "active" : "")">° Usuarios</a>
        <a href="/Admin/VerDocentes" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "VerDocentes" ? "active" : "")">° Docentes</a>
        <a href="/Admin/Reportes">° Reportes Extras</a>
        <a href="/Admin/Extras">° Extras</a>
        <a href="/Admin/Solicitudes" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Solicitudes" ? "active" : "")">° Solicitudes</a>
        <a href="/Admin/ReporteLlaves" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ReporteLlaves" ? "active" : "")">° Reporte de Llaves</a>
        <a href="/Admin/SinDevolver" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "SinDevolver" ? "active" : "")">° Pendientes</a>

        <a href="/Admin/Llaves" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Llaves" ? "active" : "") d-flex justify-content-between align-items-center">
            ° Llaves
            @if (ViewBag.LlavesPendientes > 0)
            {
                <span class="badge-alert">@ViewBag.LlavesPendientes</span>
            }
        </a>

        <!-- Contador global al final -->
        <div class="llaves-counter mt-4 mb-3">
            <i class="bi bi-key-fill"></i> Llaves no devueltas:
            <span>@(ViewBag.LlavesPendientes ?? 0)</span>
        </div>
    </div>

    <!-- Contenido principal -->
    <div class="content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
