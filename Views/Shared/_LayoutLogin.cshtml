<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Sistema Gestión de Llaves</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* Mejorar la fuente y el centrado vertical */
        body {
            background-color: #f5f5f5;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh; /* Usar min-height para mejor compatibilidad de contenido */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0; /* Asegurar que no haya márgenes por defecto */
        }

        /* Estilo de la tarjeta principal */
        .login-card {
            background: white;
            padding: 35px; /* Aumentar el padding para más aire */
            border-radius: 18px; /* Radio de borde ligeramente mayor */
            box-shadow: 0 10px 30px rgba(0,0,0,0.15); /* Sombra más profunda */
            width: 100%;
            max-width: 420px;
            margin: 20px; /* Margen para pantallas pequeñas */
        }

        .logo-img {
            width: 90px;
            height: 90px; /* Asegurar que es un cuadrado si es un logo */
            display: block;
            margin: 0 auto 25px auto;
            object-fit: contain; /* Para que la imagen se vea bien */
        }

        /* Estilo consistente para el botón primario */
        .btn-primary-custom {
            background-color: #72103A !important;
            border-color: #72103A !important;
            transition: background-color 0.3s ease, transform 0.1s ease;
        }

            .btn-primary-custom:hover {
                background-color: #5d0c2e !important; /* Tono más oscuro al pasar el ratón */
                transform: translateY(-1px);
            }
    </style>
</head>
<body>
    <div class="login-card">
        <img src="~/images/Logo.jpg" alt="Universidad del Valle - Bolivia" class="logo-img">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>