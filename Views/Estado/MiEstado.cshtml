@{
    ViewData["Title"] = "Mi Estado";
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
}

<div class="estado-wrapper d-flex justify-content-center align-items-center min-vh-100">
    <div class="estado-card shadow-lg text-center p-4">
        <h2 class="fw-bold mb-3" style="color:#7A0026;">Estado Actual del Préstamo</h2>

        <div class="icon-container mb-3">
            <i class="bi bi-clock-history icon-glow"></i>
        </div>

        <div class="info-section text-start mb-3">
            <p><strong>📘 Materia:</strong> <span>@Model.MateriaNombre</span></p>
            <p><strong>🕒 Inicio:</strong> <span>@Model.HoraInicio.ToString("HH:mm")</span></p>
            <p><strong>🕕 Fin:</strong> <span>@Model.HoraFin.ToString("HH:mm")</span></p>
        </div>

        <div class="progress-container mb-3">
            <div class="progress" style="height: 22px; border-radius:12px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-gradient"
                     role="progressbar"
                     style="width:@Model.PorcentajeTranscurrido%">
                    @Model.PorcentajeTranscurrido.ToString("0")%
                </div>
            </div>
        </div>

        <h5 class="fw-semibold mt-3 mb-1">Tiempo restante</h5>
        <div id="contador" class="contador fs-4 fw-bold text-dark">
            @Model.TiempoRestante.ToString(@"hh\:mm\:ss")
        </div>

        <hr class="my-4" />

        <div class="stats-grid">
            <div class="stat-item">
                <i class="bi bi-calendar-check"></i>
                <p>Total préstamos</p>
                <span>@Model.TotalPrestamos</span>
            </div>
            <div class="stat-item">
                <i class="bi bi-clock"></i>
                <p>Devoluciones a tiempo</p>
                <span>@Model.DevolucionesATiempo</span>
            </div>
            <div class="stat-item">
                <i class="bi bi-lightning-charge"></i>
                <p>Racha de días</p>
                <span>@Model.RachaDias</span>
            </div>
        </div>
    </div>
</div>

<style>
    /* Fondo general con degradado suave */
    body {
        background: linear-gradient(to bottom right, #7a0026e6, #b5004ae6), url('/images/fondo-univalle.jpg') center/cover no-repeat fixed;
        background-blend-mode: overlay;
    }

    .estado-wrapper {
        padding: 40px 15px;
    }

    /* Tarjeta principal */
    .estado-card {
        max-width: 420px;
        width: 100%;
        background: rgba(255, 255, 255, 0.92);
        border-radius: 1.2rem;
        backdrop-filter: blur(10px);
        transition: transform 0.3s ease;
    }

        .estado-card:hover {
            transform: scale(1.02);
        }

    /* Icono superior */
    .icon-container {
        font-size: 3rem;
        color: #b5004a;
    }

    .icon-glow {
        text-shadow: 0 0 10px rgba(181, 0, 74, 0.5);
        animation: glowPulse 2s infinite;
    }

    @@keyframes glowPulse {
        0%, 100% {
            text-shadow: 0 0 10px rgba(181,0,74,0.4);
        }

        50% {
            text-shadow: 0 0 20px rgba(181,0,74,0.8);
        }
    }


    /* Progreso con gradiente */
    .progress-bar.bg-gradient {
        background: linear-gradient(90deg, #b5004a, #ff7b9c);
    }

    /* Estadísticas */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        text-align: center;
    }

    .stat-item i {
        font-size: 1.5rem;
        color: #b5004a;
    }

    .stat-item span {
        display: block;
        font-size: 1.2rem;
        font-weight: 600;
        color: #333;
    }

    .stat-item p {
        font-size: 0.9rem;
        margin-bottom: 4px;
        color: #555;
    }
</style>

<script>
    // 🔹 Actualiza el contador en tiempo real
    const end = new Date("@Model.HoraFin").getTime();
    const counter = document.getElementById("contador");

    setInterval(() => {
        const now = new Date().getTime();
        const diff = end - now;
        if (diff <= 0) {
            counter.textContent = "Finalizado";
            counter.style.color = "#b5004a";
            return;
        }
        const hrs = Math.floor(diff / (1000 * 60 * 60));
        const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const secs = Math.floor((diff % (1000 * 60)) / 1000);
        counter.textContent = `${hrs.toString().padStart(2,'0')}:${mins.toString().padStart(2,'0')}:${secs.toString().padStart(2,'0')}`;
    }, 1000);
</script>
