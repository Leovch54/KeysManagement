@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Universidad del Valle</title>

    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="login-container">
        <div class="logo-section">
            <img src="~/images/Logo.jpg" alt="Universidad del Valle - Bolivia" class="university-logo-img">
        </div>

        <div class="form-wrapper">
            <div class="login-form">
                <h1 class="form-title">Bienvenido a Llaves!</h1>
                <p class="form-subtitle">Ingresa tus credenciales para acceder al sistema</p>

                <form method="post" id="loginForm">
                    <div class="input-group">
                        <div class="input-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <input type="email" name="email" class="input-field" placeholder="Ingresa tu usuario" required>
                    </div>

                    <div class="input-group">
                        <div class="input-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <circle cx="12" cy="16" r="1"></circle>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </div>
                        <input type="password" name="contrasenia" class="input-field" placeholder="Ingresa tu Contraseña" required>
                    </div>

                    <div class="form-options">
                        <label class="remember-user">
                            <input type="checkbox" name="remember">
                            Recordar usuario
                        </label>
                        <a asp-action="RecuperarPassword" class="forgot-password">Olvidó su contraseña?</a>
                    </div>

                    <button type="submit" class="login-button">Ingresar</button>

                    @if (ViewBag.Mensaje != null)
                    {
                        <div class="error-message">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="15" y1="9" x2="9" y2="15"></line>
                                <line x1="9" y1="9" x2="15" y2="15"></line>
                            </svg>
                            <span>@ViewBag.Mensaje</span>
                        </div>
                    }
                </form>
            </div>

            <!-- Footer -->
            <div class="footer-link">
                <a href="/Politicas/Privacidad">Política de privacidad</a>
            </div>
        </div>
    </div>

</body>
</html>