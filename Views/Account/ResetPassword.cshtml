@{
    ViewData["Title"] = "Restablecer Contraseña";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="text-center">
    <h4 class="mb-4 fw-bold" style="color:#72103A;">
        <i class="bi bi-arrow-clockwise me-2"></i> Restablecer Contraseña
    </h4>
    <p class="text-muted small mb-4">
        Establece una nueva contraseña segura para tu cuenta.
    </p>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-info text-center small mb-4" role="alert">
            <i class="bi bi-info-circle-fill me-1"></i> @ViewBag.Mensaje
        </div>
    }

    <form asp-action="ResetPassword" asp-controller="Account" method="post">
        <input type="hidden" name="email" value="@ViewBag.Email" />
        <input type="hidden" name="token" value="@ViewBag.Token" />

        <div class="mb-4">
            <label for="nuevaPassword" class="form-label fw-semibold">
                <i class="bi bi-lock-fill me-1"></i> Nueva Contraseña
            </label>
            <input type="password" id="nuevaPassword" name="nuevaPassword"
                   class="form-control form-control-lg" placeholder="Mínimo 8 caracteres" required
                   aria-describedby="nuevaPasswordHelp" />
            <div id="nuevaPasswordHelp" class="form-text text-start">
                Combina mayúsculas, minúsculas y números.
            </div>
        </div>

        <div class="mb-5">
            <label for="confirmarPassword" class="form-label fw-semibold">
                <i class="bi bi-arrow-repeat me-1"></i> Confirmar Contraseña
            </label>
            <input type="password" id="confirmarPassword" name="confirmarPassword"
                   class="form-control form-control-lg" placeholder="Repite la nueva contraseña" required />
        </div>

        <button type="submit" class="btn btn-primary-custom btn-lg w-100 text-white fw-bold">
            <i class="bi bi-save-fill me-2"></i> Guardar Nueva Contraseña
        </button>
    </form>
</div>