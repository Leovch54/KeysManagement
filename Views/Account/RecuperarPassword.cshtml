@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow p-4">
        <h4 class="text-center mb-3" style="color:#72103A;">Recuperar Contraseña</h4>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-info text-center">@ViewBag.Mensaje</div>
        }

        <form asp-action="RecuperarPassword" asp-controller="Account" method="post">
            <div class="mb-3">
                <label class="form-label">Correo electrónico</label>
                <input type="email" name="email" class="form-control" required />
            </div>

            <button type="submit" class="btn w-100 text-white" style="background-color:#72103A;">Enviar enlace</button>

            <div class="text-center mt-3">
                <a href="/Account/Login" style="color:#72103A;">Volver al inicio</a>
            </div>
        </form>
    </div>
</div>
