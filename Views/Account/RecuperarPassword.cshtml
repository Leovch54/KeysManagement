@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="text-center">
    <h4 class="mb-4 fw-bold" style="color:#72103A;">
        <i class="bi bi-question-circle-fill me-2"></i> ¿Olvidaste tu Contraseña?
    </h4>
    <p class="text-muted small mb-4">
        Introduce tu correo electrónico. Te enviaremos un enlace para restablecer tu acceso.
    </p>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-success text-center small mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @ViewBag.Mensaje
        </div>
    }

    <form asp-action="RecuperarPassword" asp-controller="Account" method="post">
        <div class="mb-4">
            <label for="email" class="form-label fw-semibold">
                <i class="bi bi-envelope-fill me-1"></i> Correo electrónico
            </label>
            <input type="email" id="email" name="email" class="form-control form-control-lg" placeholder="ejemplo@univalle.edu" required />
        </div>

        <button type="submit" class="btn btn-primary-custom btn-lg w-100 text-white fw-bold mb-3">
            <i class="bi bi-send-fill me-2"></i> Enviar Enlace
        </button>

        <div class="mt-3">
            <a href="/Account/Login" class="text-decoration-none fw-semibold" style="color:#72103A;">
                <i class="bi bi-arrow-left me-1"></i> Volver al Inicio de Sesión
            </a>
        </div>
    </form>
</div>