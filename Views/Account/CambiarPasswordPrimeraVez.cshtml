@{
    ViewData["Title"] = "Cambiar Contraseña";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="text-center">
    <h4 class="mb-4 fw-bold" style="color:#72103A;">
        <i class="bi bi-shield-lock-fill me-2"></i> Cambio de Contraseña Inicial
    </h4>
    <p class="text-muted small mb-4">
        Por seguridad, debes cambiar tu contraseña predeterminada para continuar.
    </p>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-warning text-center small mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Mensaje
        </div>
    }

    <form asp-action="CambiarPasswordPrimeraVez" asp-controller="Account" method="post">
        <input type="hidden" name="email" value="@ViewBag.Email" />

        <div class="mb-4">
            <label for="actualPassword" class="form-label fw-semibold">
                <i class="bi bi-key-fill me-1"></i> Contraseña Actual (Inicial)
            </label>
            <input type="password" id="actualPassword" name="actualPassword"
                   class="form-control form-control-lg" placeholder="Contraseña temporal" required />
        </div>

        <div class="mb-4">
            <label for="nuevaPassword" class="form-label fw-semibold">
                <i class="bi bi-lock-fill me-1"></i> Nueva Contraseña
            </label>
            <input type="password" id="nuevaPassword" name="nuevaPassword"
                   class="form-control form-control-lg" placeholder="Nueva contraseña segura" required />
        </div>

        <div class="mb-5">
            <label for="confirmarPassword" class="form-label fw-semibold">
                <i class="bi bi-arrow-repeat me-1"></i> Confirmar Nueva Contraseña
            </label>
            <input type="password" id="confirmarPassword" name="confirmarPassword"
                   class="form-control form-control-lg" placeholder="Repita la nueva contraseña" required />
        </div>

        <button type="submit" class="btn btn-primary-custom btn-lg w-100 text-white fw-bold">
            <i class="bi bi-check-circle-fill me-2"></i> Guardar y Acceder
        </button>
    </form>
</div>