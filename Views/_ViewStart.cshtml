@{
    var rol = Context.Session.GetString("UsuarioRol");

    if (string.IsNullOrEmpty(rol))
    {
        Layout = "_LayoutDocente"; // Para login/páginas públicas
    }
    else if (rol == "ADMIN")
    {
        Layout = "_LayoutAdmin";
    }
    else if (rol == "DOCENTE")
    {
        Layout = "_LayoutDocente";
    }
    else
    {
        Layout = "_LayoutDocente";
    }
}