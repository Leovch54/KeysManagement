@{
    ViewData["Title"] = "Gestión de Docentes";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid my-4">
    <header class="mb-5 d-flex justify-content-between align-items-center">
        <h2 class="text-dark"><i class="fas fa-graduation-cap me-2 text-success"></i> Lista de Docentes</h2>
       
    </header>

    <div class="card shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Buscar por nombre, correo o teléfono..." onkeyup="filtrarTabla()">
                    </div>
                </div>
                <div class="col-md-6 text-md-end mt-2 mt-md-0">
                    <span class="text-muted">Total de docentes: <strong id="totalDocentes">@ViewBag.Docentes.Count</strong></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0" id="tablaDocentes">
                    <thead class="bg-success text-white">
                        <tr>
                            <th>Nombre Completo</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Tipo</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.Docentes != null && ViewBag.Docentes.Count > 0)
                        {
                            @foreach (var d in ViewBag.Docentes)
                            {
                                // Determinar el color del badge para el Tipo
                                string badgeClass = d.Tipo == "Planta" ? "bg-success" : (d.Tipo == "Contratado" ? "bg-info" : "bg-secondary");

                                <tr>
                                    <td>@d.Nombres @d.PrimerApellido @d.SegundoApellido</td>
                                    <td>@d.Email</td>
                                    <td>@d.Telefono</td>
                                    <td>
                                        <span class="badge @badgeClass">@d.Tipo</span>
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("VerHorarios", "Admin", new { docenteId = d.Id })" class="btn btn-sm btn-info shadow-sm" title="Ver Horarios">
                                            <i class="fas fa-calendar-alt me-1"></i> Horarios
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="fas fa-box-open me-2"></i> No hay docentes registrados en el sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Función de filtrado mejorada para mayor eficiencia
        function filtrarTabla() {
            const input = document.getElementById("searchInput");
            const filter = input.value.toUpperCase().trim();
            const table = document.getElementById("tablaDocentes");
            const tbody = table.getElementsByTagName("tbody")[0];
            const rows = tbody.getElementsByTagName("tr");

            let visibleCount = 0;

            for (let i = 0; i < rows.length; i++) {
                const row = rows[i];
                // Ignorar la fila de "No hay docentes" si está presente
                if (row.cells.length < 4) continue;

                // Columnas a buscar: Nombre (0), Email (1), Teléfono (2)
                const tdNombre = row.cells[0].textContent.toUpperCase();
                const tdEmail = row.cells[1].textContent.toUpperCase();
                const tdTelefono = row.cells[2].textContent.toUpperCase();

                if (tdNombre.includes(filter) ||
                    tdEmail.includes(filter) ||
                    tdTelefono.includes(filter)) {

                    row.style.display = "";
                    visibleCount++;
                } else {
                    row.style.display = "none";
                }
            }

            // Actualizar el contador de docentes visibles
            document.getElementById('totalDocentes').textContent = visibleCount;
        }

        // Cargar script al iniciar la página
        document.addEventListener('DOMContentLoaded', filtrarTabla);
    </script>
}