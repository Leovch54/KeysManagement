@using GestionLlaves.Models;
@{
    ViewData["Title"] = "Reportes de Solicitudes Extras";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var reportes = ViewBag.Reportes as List<Reportes> ?? new List<Reportes>();
}

<div class="container-fluid my-4">
    <header class="mb-5">
        <h2 class="text-dark"><i class="fas fa-clipboard-list me-2 text-info"></i> Reportes de Solicitudes Extras</h2>
        <p class="text-muted">Historial completo de llaves solicitadas fuera del cronograma estándar.</p>
    </header>

    <div class="card shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Buscar por Área, Nombre o Aula..." onkeyup="filtrarReportes()">
                    </div>
                </div>
                <div class="col-md-4">
                    <select id="estadoFilter" class="form-select" onchange="filtrarReportes()">
                        <option value="">-- Filtrar por Estado --</option>
                        <option value="Devuelto">Devuelto</option>
                        <option value="Pendiente">Pendiente</option>
                    </select>
                </div>
                <div class="col-md-2 text-md-end">
                    <span class="text-muted">Total: <strong id="totalReportes">@reportes.Count</strong></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0" id="tablaReportes">
                    <thead class="bg-info text-white">
                        <tr>
                            <th>Área</th>
                            <th>Nombre Solicitante</th>
                            <th>Aula</th>
                            <th>F. Solicitud</th>
                            <th>F. Devolución</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (reportes.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="fas fa-box-open me-2"></i> No hay registros de reportes extras aún.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in reportes)
                            {
                                // Lógica de clases Razor
                                string estado = item.Estado == "Devuelto" ? "Devuelto" : "Pendiente";
                                string badgeClass = estado == "Devuelto" ? "bg-success" : "bg-warning text-dark";

                                <tr data-estado="@estado">
                                    <td>@item.Area</td>
                                    <td>@item.Nombre</td>
                                    <td>@item.Aula</td>
                                    <td>@item.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(item.FechaDevolucion.HasValue? item.FechaDevolucion.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                    <td class="text-center">
                                        <span class="badge @badgeClass">@estado</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Función unificada para filtrar por texto y estado
        function filtrarReportes() {
            const input = document.getElementById("searchInput");
            const filter = input.value.toUpperCase().trim();
            const estadoFilter = document.getElementById("estadoFilter").value.toUpperCase();
            const table = document.getElementById("tablaReportes");
            const tbody = table.getElementsByTagName("tbody")[0];
            const rows = tbody.getElementsByTagName("tr");

            let visibleCount = 0;

            for (let i = 0; i < rows.length; i++) {
                const row = rows[i];
                // Saltar la fila de "No hay registros" si está visible
                if (row.cells.length < 5) continue;

                // 1. Filtrado por texto (Área, Nombre, Aula)
                // Columnas a buscar: Área (0), Nombre (1), Aula (2)
                const tdArea = row.cells[0].textContent.toUpperCase();
                const tdNombre = row.cells[1].textContent.toUpperCase();
                const tdAula = row.cells[2].textContent.toUpperCase();

                const textMatch = tdArea.includes(filter) ||
                                  tdNombre.includes(filter) ||
                                  tdAula.includes(filter);

                // 2. Filtrado por estado
                const rowEstado = row.getAttribute('data-estado')?.toUpperCase() || '';
                const estadoMatch = estadoFilter === '' || rowEstado === estadoFilter;

                // Mostrar fila si cumple ambos filtros
                if (textMatch && estadoMatch) {
                    row.style.display = "";
                    visibleCount++;
                } else {
                    row.style.display = "none";
                }
            }

            // Actualizar el contador de reportes visibles
            document.getElementById('totalReportes').textContent = visibleCount;
        }

        // Ejecutar el filtro al cargar para asegurar que el contador inicial sea correcto
        document.addEventListener('DOMContentLoaded', function() {
            // Inicialmente solo llamamos al filtro para actualizar el contador
            // si la lista está vacía no tiene efecto.
            if (document.getElementById("tablaReportes").getElementsByTagName("tbody")[0].rows.length > 0) {
                 filtrarReportes();
            }
        });
    </script>
}