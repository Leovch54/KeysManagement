@{
    // Mantengo el Razor block como está
    ViewData["Title"] = "Panel de Administración";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container my-4">
    <header class="mb-5">
        <h1 class="display-6 text-dark"><i class="fas fa-chart-line text-primary me-2"></i> Dashboard Administrativo</h1>
        <p class="lead">Bienvenido de vuelta, **@ViewBag.Email**.</p>
    </header>

    <div class="row g-4">
        <div class="col-sm-12 col-md-4">
            <div class="card shadow-sm h-100 border-start border-primary border-5">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-primary fw-bold mb-1">Llaves en Uso</p>
                            <h2 id="llavesEnUso" class="display-4 text-primary fw-bolder">
                                <span class="placeholder col-4 bg-primary rounded"></span>
                            </h2>
                            <p class="text-muted small mb-0">Actualmente prestadas</p>
                        </div>
                        <i class="fas fa-key fa-3x text-primary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-12 col-md-4">
            <div class="card shadow-sm h-100 border-start border-success border-5">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-success fw-bold mb-1">Aulas Disponibles</p>

                            <h2 id="aulasDisponibles" class="display-4 text-success fw-bolder">
                                <span class="placeholder col-4 bg-success rounded"></span>
                            </h2>

                            <a href="@Url.Action("DisponibilidadAulas", "Admin")" class="btn btn-success shadow-sm mt-2">
                                <i class="fas fa-door-open me-1"></i> Ver Disponibilidad
                            </a>

                            <p class="text-muted small mb-0">Listas para usar</p>
                        </div>

                        <i class="fas fa-door-open fa-3x text-success opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-sm-12 col-md-4">
            <div class="card shadow-sm h-100 border-start border-info border-5">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-info fw-bold mb-1">Préstamos Hoy</p>
                            <h2 id="prestamosHoy" class="display-4 text-info fw-bolder">
                                <span class="placeholder col-4 bg-info rounded"></span>
                            </h2>
                            <p class="text-muted small mb-0">Registrados en el día</p>
                        </div>
                        <i class="fas fa-calendar-day fa-3x text-info opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white p-3">
                    <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i> Top 5 Docentes con Mayor Demora en Devolución</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Posición</th>
                                    <th>Docente</th>
                                    <th>Email</th>
                                    <th>Promedio Retraso (horas)</th>
                                    <th>Total Retrasos</th>
                                </tr>
                            </thead>
                            <tbody id="docentesMorosos">
                                <tr>
                                    <td colspan="5" class="text-center py-4">
                                        <div class="spinner-border spinner-border-sm text-danger me-2" role="status">
                                            <span class="visually-hidden">Cargando...</span>
                                        </div>
                                        Cargando datos...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12 text-center">
            <h4 class="mb-3 text-secondary">Acciones Rápidas</h4>
            <div class="d-grid gap-2 d-md-block">
                <a href="@Url.Action("VerDocentes", "Admin")" class="btn btn-lg btn-primary shadow-sm m-2">
                    <i class="fas fa-user-tie me-2"></i> Ver Docentes
                </a>
                <a href="@Url.Action("VerUsuarios", "Admin")" class="btn btn-lg btn-secondary shadow-sm m-2">
                    <i class="fas fa-users me-2"></i> Ver Usuarios
                </a>
                <a href="@Url.Action("RegistrarUsuario", "Admin")" class="btn btn-lg btn-success shadow-sm m-2">
                    <i class="fas fa-user-plus me-2"></i> Registrar Usuario
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Función principal para cargar y renderizar el dashboard
        function cargarDashboard() {
            // Placeholder/Loader activo mientras se realiza la petición
            const llavesEnUsoEl = document.getElementById('llavesEnUso');
            const aulasDisponiblesEl = document.getElementById('aulasDisponibles');
            const prestamosHoyEl = document.getElementById('prestamosHoy');
            const docentesMorososTbody = document.getElementById('docentesMorosos');

            // Muestra placeholders si no tienen contenido (solo al inicio)
            if (!llavesEnUsoEl.textContent.trim() || llavesEnUsoEl.textContent.includes('0')) {
                 llavesEnUsoEl.innerHTML = '<span class="placeholder col-4 bg-primary rounded"></span>';
                 aulasDisponiblesEl.innerHTML = '<span class="placeholder col-4 bg-success rounded"></span>';
                 prestamosHoyEl.innerHTML = '<span class="placeholder col-4 bg-info rounded"></span>';
            }


            fetch('@Url.Action("ObtenerEstadisticasDashboard", "Admin")')
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    // 1. Actualizar tarjetas
                    llavesEnUsoEl.textContent = data.llavesEnUso;
                    aulasDisponiblesEl.textContent = data.aulasDisponibles;
                    prestamosHoyEl.textContent = data.prestamosHoy;

                    // 2. Actualizar tabla de docentes morosos
                    renderizarTablaMorosos(data.docentesMorosos, docentesMorososTbody);
                })
                .catch(error => {
                    console.error('Error al cargar estadísticas:', error);

                    // Muestra error en las tarjetas (opcional)
                    llavesEnUsoEl.textContent = '!';
                    aulasDisponiblesEl.textContent = '!';
                    prestamosHoyEl.textContent = '!';

                    // Muestra mensaje de error en la tabla
                    docentesMorososTbody.innerHTML =
                        '<tr><td colspan="5" class="text-center text-danger py-3"><i class="fas fa-exclamation-circle me-2"></i> Error al cargar los datos del servidor.</td></tr>';
                });
        }

        // Función auxiliar para renderizar la tabla
        function renderizarTablaMorosos(docentes, tbody) {
            tbody.innerHTML = ''; // Limpiar contenido anterior

            if (docentes.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center py-3">No hay registros de retrasos en las devoluciones.</td></tr>';
            } else {
                let htmlContent = '';
                docentes.forEach((docente, index) => {
                    // Uso de template strings para un código más limpio
                    htmlContent += `
                        <tr>
                            <td><strong>${index + 1}</strong></td>
                            <td>${docente.nombreCompleto}</td>
                            <td>${docente.email}</td>
                            <td class="text-danger fw-bold">${docente.promedioRetrasoHoras.toFixed(2)}</td>
                            <td>${docente.totalRetrasos}</td>
                        </tr>
                    `;
                });
                tbody.innerHTML = htmlContent;
            }
        }


        // Inicialización y Auto-actualización
        document.addEventListener('DOMContentLoaded', function() {
            // Carga inicial
            cargarDashboard();

            // Auto-actualizar cada 30 segundos (30000 milisegundos)
            setInterval(cargarDashboard, 30000);
        });

    </script>
}