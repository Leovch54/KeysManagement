@model List<GestionLlaves.Models.ViewModels.HorarioItemVM>
@{
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
    ViewData["Title"] = "Mi Horario";
}

<div class="container my-3">
    <h2>@ViewData["FechaLabel"]</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-light">No tienes clases hoy.</div>
    }

    @foreach (var c in Model)
    {
        <div class="card mb-2 shadow-sm">
            <div class="card-body d-flex justify-content-between">
                <div>
                    <div class="fw-bold">@c.Materia</div>
                    <div class="text-muted">@c.Aula</div>
                </div>
                <div>
                    <div>@c.Inicio.ToString(@"hh\:mm") - @c.Fin.ToString(@"hh\:mm")</div>
                    @if (c.EnCurso)
                    {
                        <span class="badge bg-success">En curso</span>
                    }
                </div>
            </div>
        </div>
    }
</div>
