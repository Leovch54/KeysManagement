@model GestionLlaves.Models.ViewModels.ReservaNuevaVM
@{
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
    ViewData["Title"] = "Nueva Reserva";
}

<div class="container my-3">
    @if (TempData["ok"] != null)
    {
        <div class="alert alert-success">@TempData["ok"]</div>
    }

    <form method="post" asp-action="NuevaReserva">
        <div class="card mb-3">
            <div class="card-header">Paso 1: Fecha y hora</div>
            <div class="card-body row g-3">
                <div class="col-md-4">
                    <label class="form-label">Fecha</label>
                    <input type="date" class="form-control" asp-for="Fecha" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Hora inicio</label>
                    <input type="time" class="form-control" asp-for="HoraInicio" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Hora fin</label>
                    <input type="time" class="form-control" asp-for="HoraFin" />
                </div>

                <div class="col-12">
                    <button type="button" class="btn btn-outline-primary" id="btnBuscar">Buscar aulas</button>
                </div>
            </div>
        </div>

        <div id="paso3"></div>

        <div class="card">
            <div class="card-header">Paso 2: Detalles</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Propósito</label>
                    <input class="form-control" asp-for="Proposito" maxlength="150" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Justificación</label>
                    <textarea class="form-control" asp-for="Justificacion" rows="4" maxlength="2000"></textarea>
                </div>

                <button class="btn btn-primary" type="submit">Enviar solicitud</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('btnBuscar').addEventListener('click', async () => {
          const f = document.querySelector('form');
          const fecha = f.querySelector('[name="Fecha"]').value;
          const hi = f.querySelector('[name="HoraInicio"]').value;
          const hf = f.querySelector('[name="HoraFin"]').value;

          if (!fecha || !hi || !hf) {
            alert('Debes seleccionar fecha, hora inicio y hora fin.');
            return;
          }

          const res = await fetch(`/Docente/AulasDisponibles?fecha=${fecha}&horaInicio=${hi}&horaFin=${hf}`);
          document.getElementById('paso3').innerHTML = await res.text();
        });
    </script>
}
