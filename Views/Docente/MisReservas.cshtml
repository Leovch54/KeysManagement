@model List<GestionLlaves.Models.ViewModels.ReservaCardVM>
@{
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
    ViewData["Title"] = "Mis Reservas";
}

<div class="container my-3">
    <a class="btn btn-primary mb-3" href="/Docente/NuevaReserva">Nueva reserva</a>

    @if (!Model.Any())
    {
        <div class="alert alert-light">No tienes reservas registradas.</div>
    }

    @foreach (var r in Model)
    {
        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-bold">@r.Aula</div>
                    <div class="text-muted">
                        @r.Inicio.ToString("dd/MM HH:mm") - @r.Fin.ToString("dd/MM HH:mm")
                    </div>
                </div>

                <span class="badge
                        @(r.Estado == "APROBADA"
                                              ? "bg-success"
                                              : r.Estado == "RECHAZADA"
                                                  ? "bg-danger"
                                                  : "bg-warning")">
                @r.Estado
            </span>
        </div>
    </div>
        }
</div>
